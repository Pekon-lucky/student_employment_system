# ===== JWT 配置 =====
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_HOURS=24

# ===== Coze 配置（阶段三，遵循 coze-chat 技能规范）=====
# 正式个人访问令牌：Coze 控制台 → 个人设置 → 访问令牌，必须 pat_ 前缀（cztei_ 是测试令牌不可用）
COZE_TOKEN=
COZE_SPACE_ID=7699303055962964008
# 工作流：模块 7 简历评估
COZE_WORKFLOW_RESUME=7700863208177565705
# 工作流：模块 9 面试题生成
COZE_WORKFLOW_QUESTIONS=7700880187995815978
# 工作流：模块 8 录音分析
COZE_WORKFLOW_AUDIO=7700886592182124594
# Bot：模块 10 模拟面试
COZE_BOT_INTERVIEW=7701523779528622114
# true=全链路 Mock（不发真实请求，测试期默认）；false=真实调用 Coze
MOCK_COZE=true
# SDK 超时（秒）：读超时须大于工作流最长耗时；连接超时默认 20s（cozepy 原生只有 5s）
COZE_TIMEOUT=600
COZE_CONNECT_TIMEOUT=20
# 留空=国内版 https://api.coze.cn；国际版填 https://api.coze.com
COZE_BASE_URL=
